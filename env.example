# Site Configuration
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_DOMAIN_NAME=yourdomain.com
NEXT_PUBLIC_CANONICAL_URL=https://yourdomain.com

# SEO Configuration
NEXT_PUBLIC_SEO_TITLE=Premium Domain for Sale - yourdomain.com
NEXT_PUBLIC_SEO_DESCRIPTION=Premium domain name yourdomain.com available for purchase. Perfect for startups, businesses, or personal projects. Get in touch today!
NEXT_PUBLIC_SEO_KEYWORDS=domain, domain sale, buy domain, premium domain, yourdomain.com
NEXT_PUBLIC_SEO_AUTHOR=Your Name

# Social Media & Open Graph
NEXT_PUBLIC_OG_IMAGE=https://yourdomain.com/og-image.jpg
NEXT_PUBLIC_TWITTER_HANDLE=yourhandle

# Search Engine Verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
NEXT_PUBLIC_YANDEX_VERIFICATION=your-yandex-verification-code
